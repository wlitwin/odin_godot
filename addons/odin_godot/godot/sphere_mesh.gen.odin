package godot

import __bindgen_gde "godot:gdext"

Sphere_Mesh_Constants :: enum {
}



sphere_mesh_name_ref :: proc "contextless" () -> ^String_Name {
    return &__class_name
}

sphere_mesh_name :: proc "contextless" () -> String_Name {
    return __class_name
