// properties
spin_box_get_alignment :: proc "contextless" (self: Spin_Box) -> Horizontal_Alignment {
    return spin_box_get_horizontal_alignment(self)
}
spin_box_set_alignment :: proc "contextless" (self: Spin_Box, value: Horizontal_Alignment) {
    spin_box_set_horizontal_alignment(self, value)
}
spin_box_get_editable :: proc "contextless" (self: Spin_Box) -> Bool {
    return spin_box_is_editable(self)
}
spin_box_get_custom_arrow_round :: proc "contextless" (self: Spin_Box) -> Bool {
    return spin_box_is_custom_arrow_rounding(self)
}
spin_box_get_select_all_on_focus :: proc "contextless" (self: Spin_Box) -> Bool {
    return spin_box_is_select_all_on_focus(self)
}

// Only interns the class StringName (used for object construction and as the
// class argument when methods lazily resolve their binds). Method binds are NOT
// fetched here -- see the note above the methods section.
spin_box_init :: proc "contextless" () {
    __class_name = new_string_name_cstring("SpinBox", true)
}

@(private = "file")
__class_name: String_Name