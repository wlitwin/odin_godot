// properties
joint2d_get_disable_collision :: proc "contextless" (self: Joint2d) -> Bool {
    return joint2d_get_exclude_nodes_from_collision(self)
}
joint2d_set_disable_collision :: proc "contextless" (self: Joint2d, value: Bool) {
    joint2d_set_exclude_nodes_from_collision(self, value)
}

// Only interns the class StringName (used for object construction and as the
// class argument when methods lazily resolve their binds). Method binds are NOT
// fetched here -- see the note above the methods section.
joint2d_init :: proc "contextless" () {
    __class_name = new_string_name_cstring("Joint2D", true)
}

@(private = "file")
__class_name: String_Name