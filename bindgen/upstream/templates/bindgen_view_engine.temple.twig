// properties
{% for prop in this.properties %}
{% if prop.emit_get %}
{{ prop.get_name }} :: proc "contextless" (self: {{ this.self }}) -> {{ prop.get_type }} {
{% if prop.has_index %}
    return {{ prop.get_call }}(self, {{ prop.index_type }}({{ i64(prop.index) }}))
{% else %}
    return {{ prop.get_call }}(self)
{% end %}
}
{% end %}
{% if prop.emit_set %}
{{ prop.set_name }} :: proc "contextless" (self: {{ this.self }}, value: {{ prop.set_type }}) {
{% if prop.has_index %}
    {{ prop.set_call }}(self, {{ prop.index_type }}({{ i64(prop.index) }}), value)
{% else %}
    {{ prop.set_call }}(self, value)
{% end %}
}
{% end %}
{% end %}

// Only interns the class StringName (used for object construction and as the
// class argument when methods lazily resolve their binds). Method binds are NOT
// fetched here -- see the note above the methods section.
{{ this.snake_name}}_init :: proc "contextless" () {
    __class_name = new_string_name_cstring("{{ this.godot_name }}", true)
}

@(private = "file")
__class_name: String_Name