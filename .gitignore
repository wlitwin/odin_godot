# ── build artifacts ─────────────────────────────────────────────────
**/bin/
*.dylib
*.so
*.dll
*.wasm
*.wasm.o
*.o
*.a
**/*.dSYM/
# compiled tool binaries
/scriptgen/scriptgen
/bindgen/upstream/bin/

# ── generated engine inputs (re-dump from the pinned Godot:
#    `godot --headless --dump-extension-api --dump-gdextension-interface`) ──
/gdextension_interface.h
/extension_api.json

# ── scriptgen output inside SCRIPT PROJECTS (regenerated by build_scripts.sh) ──
#    NOTE: godot/*.gen.odin and bindgen/upstream/godot/*.gen.odin are the
#    CHECKED-IN typed binding — deliberately NOT ignored. Only per-project
#    script codegen + the wasm compose file are build artifacts.
tests/**/*.gen.odin
examples/**/*.gen.odin
**/odin_godot_web_wasm32.odin

# ── Godot project caches / generated metadata ───────────────────────
**/.godot/
# .uid files are regenerated by Godot's importer; not tracked in this repo.
*.uid
**/*.import

# ── export / run artifacts ──────────────────────────────────────────
tests/*/out/
tests/*/.export_build/
examples/*/out/
examples/*/.export_build/
tests/.logs/
tests/rpc_net/.runlogs/
/tests/debug/bt_probe
# resources test: .tres files written at runtime (authored examples/*.tres are kept)
/tests/resources/*.tres

# ── nix ─────────────────────────────────────────────────────────────
/result
/result-*

# ── editor / misc ───────────────────────────────────────────────────
*.tmp

# ── web browser-test deps (puppeteer-core, installed by the web test) ──
/tests/web/node_modules/
/tests/web/package.json
/tests/web/package-lock.json
/tests/web_showcase/node_modules
