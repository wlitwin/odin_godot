config_version=5

[application]
config/name="Replay Cavecrawl"
run/main_scene="res://cave.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1200
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.09, 1)

[editor]
script/search_in_file_extensions=PackedStringArray("gd", "gdshader", "odin")
