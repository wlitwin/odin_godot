config_version=5
[application]
config/name="Replay Scrapyard"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="replay_scrapyard"
run/flush_stdout_on_print=true
[display]
window/size/viewport_width=1280
window/size/viewport_height=704
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.09, 0.08, 0.07, 1)

[editor_plugins]
enabled=PackedStringArray("res://addons/replay_authoring/plugin.cfg")
