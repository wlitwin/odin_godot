# Operator template. Replace every example path/address; keep the actual file private.
# Use the exact cohort printed by DOCKYARD_LOBBY for the selected Web artifact.
# Required: 0x followed by the exact16hex cohort of the selected Web artifact.
# The packaging tool fills this from a matching actual runtime record.
REPLAY_ROOM_CONTENT=
REPLAY_ROOM_CHECKPOINT_MODEL=disabled
REPLAY_ROOM_BIND=0.0.0.0
REPLAY_ROOM_PORT=49740
REPLAY_ROOM_CAPACITY=16
REPLAY_ROOM_MODE=cooperative
REPLAY_ROOM_DB=/PRIVATE/dockyard/rooms.sqlite3
# Set to 1 only for intentional first-time database creation.
REPLAY_ROOM_CREATE_DB=0
REPLAY_ROOM_CERT=/PRIVATE/tls/rooms-fullchain.pem
REPLAY_ROOM_KEY=/PRIVATE/tls/rooms-key.pem
REPLAY_ROOM_LOCAL_DEVELOPMENT=0
REPLAY_ROOM_TURN_SECRET_FILE=/PRIVATE/dockyard/turn-secret
REPLAY_ROOM_TURN_URLS=turn:turn.example.invalid:3478?transport=udp,turns:turn.example.invalid:5349?transport=tcp
REPLAY_ROOM_TURN_TTL=600
REPLAY_ROOM_TURN_RELAY_ONLY=1
