[configuration]

entry_symbol = "odin_hello_init"
compatibility_minimum = "4.7"

[libraries]
macos.debug = "bin/hello.dylib"
macos.release = "bin/hello.dylib"
macos.debug.arm64 = "bin/hello.dylib"
macos.release.arm64 = "bin/hello.dylib"

linux.debug = "bin/hello.so"
linux.release = "bin/hello.so"

windows.debug = "bin/hello.dll"
windows.release = "bin/hello.dll"
