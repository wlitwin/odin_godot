FROM docker.io/library/debian@sha256:a3bba7dc7dbcc1f37c2856c51fc9a7fac96608f50cb87b1b4e4d8b8c85ae988e

# New task-owned amd64 image only. The cached base and user containers are inputs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential clang llvm lld cmake ninja-build \
    python3 unzip xz-utils file patchelf pkg-config \
    libx11-6 libxcursor1 libxinerama1 libxi6 libxrandr2 libxrender1 \
    libgl1 libegl1 libasound2 libpulse0 libfontconfig1 libfreetype6 libvulkan1 \
    libdbus-1-3 libtinfo6 libzstd1 zlib1g libedit2 libxml2 \
    && rm -rf /var/lib/apt/lists/*

COPY toolchain.py pipeline.py /opt/box3d-gate-c/
ENV XDG_CACHE_HOME=/work/cache/xdg XDG_DATA_HOME=/work/data \
    ODIN=/work/tools/odin/odin GODOT=/work/tools/godot/Godot_v4.7.1-stable_linux.x86_64 \
    CC=/usr/bin/clang JOBS=2
WORKDIR /work
CMD ["sleep", "infinity"]
