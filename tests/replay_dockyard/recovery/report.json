  "implementation": [
    "One Room.Session; actual Observer role separate from provision membership role; fresh creator invite index1.",
    "Managed redirect preserves the existing phase-aware permit and its exact retained owner. Legacy redirect defaults remain unchanged.",
    "Application protocol3 readiness/ack explicitly binds accepted peer generation and app version is included in service cohort.",
    "Cold process return observes the validated action watermark without recording old attempts as local new issues.",
    "Host crash or hosting permission loss ends the job; checked close precedes fresh scene/new crew. No automatic managed authority takeover."
  ],
  "limits": [
    "All browser cases are local, same-artifact functional proofs with software GL/3D drawing disabled. No public Internet, GPU/frame budget or human-playtest inference.",
    "Cases are build-specific; final Q1/release checklist must use the final frozen candidate after P1.",
    "The original gap-v1 controller/runtime PASS has a separate INCOMPLETE provenance sidecar because its shared helper changed during execution; the final gap-v2 has before/after helper fences.",
    "Early cases preceding the helper-fence addition record their helper hash without a before/after assertion; original raw results and scope remain unchanged.",
    "Cold return drains the original action before process exit; pending-attempt preservation is established by the separate live-Client transient case, not arbitrary process persistence.",
    "N1 public endpoint acceptance remains blocked and is not closed by this card.",
    "Authority browser-close case claims no typed shutdown for the deliberately lost authority; surviving/new actors require checked teardown."
  ],
  "retained_failures": [
    "pending-reconnect-v1: managed permit owner/data mismatch caused stalled replacement.",
    "pending-reconnect-v2/v3: complete-state replacement/outcome succeeded but strict final application generation acknowledgement failed.",
    "frozen-v1: harness treated the explicitly injected browser BFCache socket event as an unclassified runtime error.",
    "gap-v1: successful runtime result retained, source provenance incomplete; corrected fenced gap-v2 is separate."
  ]
}
